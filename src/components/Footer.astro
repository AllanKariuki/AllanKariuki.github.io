---
import { SITE } from "../data/site";
---

<footer class="mt-24 border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>© 2026 {SITE.name} · Built with Astro, hosted on GitHub Pages</p>
    <ul class="flex gap-5">
      <li><a class="hover:text-accent" href={SITE.github} target="_blank" rel="noopener">GitHub</a></li>
      <li><a class="hover:text-accent" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a class="hover:text-accent" href={`mailto:${SITE.email}`}>Email</a></li>
    </ul>
  </div>
</footer>
