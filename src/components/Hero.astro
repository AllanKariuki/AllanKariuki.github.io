---
import Icon from "./Icon.astro";
import { HERO, SITE, STACK_TILES } from "../data/site";
---

<section id="home" class="grid min-h-[calc(100svh-4rem)] items-center gap-12 py-16 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
  <div class="reveal">
    <span class="pill">{HERO.eyebrow}</span>
    <h1 class="mt-6 text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
      {SITE.name} — <span class="text-accent">{SITE.role}</span> building real-time, financial and Web3 systems
    </h1>
    <p class="mt-6 max-w-xl font-display text-sm leading-relaxed text-muted sm:text-base">{HERO.stackLine}</p>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-fg/85 sm:text-lg">{HERO.summary}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/#projects" class="btn btn-primary">View my work <Icon name="arrow-right" size={14} /></a>
      <a href={SITE.cv} target="_blank" rel="noopener" class="btn btn-outline">Download CV</a>
    </div>
    <div class="mt-6 flex gap-2">
      <a class="icon-btn" href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a>
      <a class="icon-btn" href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
      <a class="icon-btn" href={`mailto:${SITE.email}`} aria-label="Email"><Icon name="mail" /></a>
      <a class="icon-btn" href={SITE.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>
    </div>
  </div>

  <div class="reveal card p-6 shadow-[0_0_60px_-15px] shadow-accent/25 sm:p-8">
    <p class="eyebrow">Stack expertise</p>
    <h2 class="mt-1 text-xl font-semibold sm:text-2xl">Technical Stack</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        STACK_TILES.map((t) => (
          <li class="flex items-center gap-3 rounded-md border border-line bg-surface-2 px-4 py-3 font-display text-sm">
            <Icon name={t.icon} class="text-accent" />
            {t.label}
          </li>
        ))
      }
    </ul>
    <div class="mt-6 flex flex-wrap gap-2">
      <span class="pill normal-case tracking-normal"><Icon name="map-pin" size={13} class="text-accent" /> {SITE.location}</span>
      <span class="pill normal-case tracking-normal"><Icon name="briefcase" size={13} class="text-accent" /> Lead Engineer</span>
      <span class="pill normal-case tracking-normal"><span class="h-1.5 w-1.5 rounded-full bg-ok"></span> Open to remote</span>
    </div>
  </div>
</section>
