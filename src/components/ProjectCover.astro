---
// Generated cover art used until a real screenshot is added via `cover`.
interface Props {
  domain: string;
  title: string;
  seed: string;
}
const { domain, title, seed } = Astro.props;

const palettes: Record<string, [string, string]> = {
  "AI/ML": ["#39d0d8", "#58a6ff"],
  "Computer Vision": ["#58a6ff", "#a371f7"],
  Fintech: ["#3fb950", "#39d0d8"],
  HealthTech: ["#39d0d8", "#3fb950"],
  Web3: ["#a371f7", "#f778ba"],
  Backend: ["#58a6ff", "#39d0d8"],
  Mobile: ["#d29922", "#58a6ff"],
  Learning: ["#a371f7", "#58a6ff"],
};
const [c1, c2] = palettes[domain] ?? ["#58a6ff", "#a371f7"];
const id = `g-${seed}`;
// Deterministic pseudo-random node layout per project.
let h = 0;
for (const ch of seed) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const rand = () => ((h = (h * 1103515245 + 12345) >>> 0) % 1000) / 1000;
const nodes = Array.from({ length: 9 }, () => ({ x: 40 + rand() * 520, y: 30 + rand() * 240 }));
// First word of the title as a wordmark, e.g. "DawaTrace", "USD-X", "Hazina".
const word = title.split(/\s+/)[0];
const fontSize = word.length <= 6 ? 64 : word.length <= 9 ? 54 : 42;
---

<svg viewBox="0 0 600 300" class="h-full w-full" role="img" aria-label={`${title} cover`} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={c1} stop-opacity="0.35"></stop>
      <stop offset="1" stop-color={c2} stop-opacity="0.12"></stop>
    </linearGradient>
  </defs>
  <rect width="600" height="300" fill="#0f1729"></rect>
  <rect width="600" height="300" fill={`url(#${id})`}></rect>
  <g stroke={c1} stroke-opacity="0.25" stroke-width="1">
    {nodes.slice(1).map((n, i) => <line x1={nodes[i].x} y1={nodes[i].y} x2={n.x} y2={n.y} />)}
  </g>
  <g fill={c2} fill-opacity="0.7">
    {nodes.map((n) => <circle cx={n.x} cy={n.y} r="3" />)}
  </g>
  <text x="300" y="168" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size={fontSize} font-weight="600" fill="#e2e8f0" fill-opacity="0.92">{word}</text>
  <text x="24" y="280" font-family="Space Grotesk, sans-serif" font-size="14" letter-spacing="3" fill={c1}>{domain.toUpperCase()}</text>
</svg>
