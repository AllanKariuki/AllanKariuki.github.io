---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  intro?: string;
}
const { eyebrow, title, id, intro } = Astro.props;
---

<div class="reveal mb-10 max-w-2xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="section-title">{title}</h2>
  {intro && <p class="mt-3 text-muted">{intro}</p>}
</div>
