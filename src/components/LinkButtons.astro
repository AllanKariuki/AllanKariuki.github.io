---
import Icon from "./Icon.astro";

interface Props {
  repo: string;
  live?: string;
  download?: string;
  video?: string;
}
const { repo, live, download, video } = Astro.props;
---

<div class="flex flex-wrap gap-3">
  {
    download && (
      <a href={download} target="_blank" rel="noopener" class="btn btn-primary">
        <Icon name="download" size={14} /> Download
      </a>
    )
  }
  {
    live && (
      <a href={live} target="_blank" rel="noopener" class="btn btn-primary">
        <Icon name="external" size={14} /> Live demo
      </a>
    )
  }
  {
    video && (
      <a href={video} target="_blank" rel="noopener" class="btn btn-outline">
        Watch demo
      </a>
    )
  }
  <a href={repo} target="_blank" rel="noopener" class="btn btn-outline"><Icon name="github" size={14} /> Source code</a>
</div>
