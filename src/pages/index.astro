---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { SITE, STACK_GROUPS } from "../data/site";

const featured = (await getCollection("projects", (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <Hero />

  <section class="mt-24" aria-labelledby="featured">
    <SectionHeading command="ls ./projects --featured" title="Featured work" id="featured" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
    <a href="/projects/" class="mt-6 inline-block font-mono text-sm text-accent hover:underline">All projects →</a>
  </section>

  <section class="mt-24" aria-labelledby="stack">
    <SectionHeading command="cat ./stack.yml" title="What I work with" id="stack" />
    <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        STACK_GROUPS.map((g) => (
          <div class="rounded-xl border border-line bg-surface p-5">
            <dt class="font-mono text-sm text-accent">{g.title}</dt>
            <dd class="mt-3 flex flex-wrap gap-1.5">
              {g.items.map((i) => (
                <span class="rounded-md border border-line bg-bg px-2 py-0.5 font-mono text-xs text-muted">{i}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="contact" class="mt-24 scroll-mt-20" aria-labelledby="contact-title">
    <div class="rounded-xl border border-line bg-surface p-6 sm:p-10">
      <p class="font-mono text-sm text-muted"><span class="text-accent">$</span> ./connect.sh --establish</p>
      <h2 id="contact-title" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Let's build something</h2>
      <p class="mt-3 max-w-xl text-muted">
        Open to roles, collaborations and interesting problems, especially in ML, fintech and products for African markets.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`mailto:${SITE.email}`} class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-bg hover:opacity-90"
          >{SITE.email}</a
        >
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-line px-4 py-2 text-sm font-medium hover:border-accent hover:text-accent">LinkedIn ↗</a
        >
      </div>
    </div>
  </section>
</Base>
