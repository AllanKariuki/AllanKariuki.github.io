---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Competencies from "../components/Competencies.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";

const all = await getCollection("projects");
const featured = all.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <Hero />

  <section id="projects" class="py-20" aria-labelledby="projects-title">
    <SectionHeader
      eyebrow="Engineering archive"
      title="Selected projects"
      id="projects-title"
      intro="Personal projects I've designed and built end to end: applied ML, fintech infrastructure, HealthTech, Web3 and mobile."
    />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
    <div class="reveal mt-10 text-center">
      <a href="/projects/" class="btn btn-outline">Show all {all.length} projects <Icon name="arrow-right" size={14} /></a>
    </div>
  </section>

  <About />
  <Experience />
  <Competencies />
  <Contact />
</Base>
