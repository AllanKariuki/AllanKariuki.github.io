---
import fs from "node:fs";
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { SITE } from "../data/site";

// Show the CV button only once public/cv.pdf has been added.
const hasCv = fs.existsSync(new URL("../../public/cv.pdf", import.meta.url));

const now = [
  { name: "DawaTrace", href: "/projects/dawatrace/", text: "computer vision + track-and-trace against counterfeit medicines" },
  { name: "USD-X Bridge", href: "/projects/usdx-bridge/", text: "a fiat-backed stablecoin moving between Ethereum and Solana" },
  { name: "Language Translator", href: "/projects/language-translator/", text: "fine-tuning NLLB-200 for English⇄Kiswahili" },
  { name: "Neural nets from scratch", href: "/projects/neural-nets-from-scratch/", text: "working through micrograd and makemore" },
];
---

<Base title="About" description={`About ${SITE.name}, a software engineer in Nairobi.`}>
  <section class="pt-12 sm:pt-16" aria-labelledby="about-title">
    <SectionHeading command="cat ./about.md" title="About me" id="about-title" />
    <div class="grid gap-10 lg:grid-cols-[1fr_18rem]">
      <div class="space-y-4 text-base leading-relaxed text-fg">
        <p>
          I'm Allan, a software engineer based in Nairobi, Kenya. I like problems where software meets the real
          constraints of the places I build for: patchy connectivity, mobile money, local languages and products that
          have to earn trust.
        </p>
        <p>
          My work spans applied ML and computer vision, fintech and payments infrastructure, Web3 and mobile. Recent
          projects include parsing M-PESA and bank SMS into a personal ledger on Android, fine-tuning a translation model
          for Kiswahili, designing a double-entry ledger behind a dual-chain stablecoin, and using on-device vision to
          check medicine packaging against counterfeits.
        </p>
        <p>
          I'm also deliberately going back to fundamentals, building neural networks from scratch, because I want to
          understand the tools I ship with, not just call them.
        </p>
      </div>
      <aside class="space-y-4">
        <div class="rounded-xl border border-line bg-surface p-5">
          <h2 class="font-mono text-sm text-accent">contact</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="hover:text-accent" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a class="hover:text-accent" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
            <li><a class="hover:text-accent" href={SITE.github} target="_blank" rel="noopener">GitHub ↗</a></li>
            <li class="text-muted">{SITE.location}</li>
          </ul>
          {
            hasCv && (
              <a href="/cv.pdf" class="mt-4 inline-block rounded-md bg-accent px-4 py-2 text-sm font-medium text-bg hover:opacity-90">
                Download CV
              </a>
            )
          }
        </div>
      </aside>
    </div>
  </section>

  <section class="mt-20" aria-labelledby="now-title">
    <SectionHeading command="ps aux | grep allan" title="What I'm working on now" id="now-title" />
    <ul class="space-y-3">
      {
        now.map((n) => (
          <li class="rounded-xl border border-line bg-surface p-4">
            <a href={n.href} class="font-medium hover:text-accent">{n.name}</a>
            <span class="text-muted"> — {n.text}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
