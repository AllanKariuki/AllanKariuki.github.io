---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page does not exist.">
  <section class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="section-title">This page doesn't exist</h1>
    <p class="mt-3 text-muted">The link may be old, or the page has moved.</p>
    <a href="/" class="btn btn-primary mt-8">Back home</a>
  </section>
</Base>
