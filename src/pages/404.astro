---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page does not exist.">
  <section class="pt-24 text-center">
    <p class="font-mono text-sm text-muted"><span class="text-accent">$</span> cd {Astro.url.pathname}</p>
    <h1 class="mt-3 font-mono text-5xl font-semibold text-gradient">404</h1>
    <p class="mt-4 text-muted">bash: no such file or directory</p>
    <a href="/" class="mt-8 inline-block rounded-md bg-accent px-4 py-2 text-sm font-medium text-bg hover:opacity-90">cd ~</a>
  </section>
</Base>
